# For local --mode llm or --check-api, copy to .env and use organizer credentials.
# Competition auto mode reads OPENAI_API_KEY and OPENAI_BASE_URL from its environment.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.alfahack-gateway26.ru/v1
# Official reserve: https://changellenge.up.railway.app/v1
# Both hosts share the same organizer key and team quota.
# Optional: this is the default; the competition proxy may replace the model.
OPENAI_MODEL=qwen/qwen3.8-27b
